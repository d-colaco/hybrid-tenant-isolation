# `make setup` writes .env from this file with a random password for each *_PASSWORD (scripts/make_env.py).
# Local lab only: every port is bound to loopback.
# The container superuser: setup, seeding and operator actions (it bypasses row-level security, as a superuser does).
LAB_ADMIN_PASSWORD=change_me_1
# The application role: not the table owner, not a superuser, no BYPASSRLS. The only role the API and the queries use.
LAB_APP_PASSWORD=change_me_2
SHARED_PORT=32141
HEAVY_PORT=32142
